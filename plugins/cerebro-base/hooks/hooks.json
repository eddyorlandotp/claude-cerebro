{
  "description": "cerebro-base: guardia contra comandos destructivos y secretos en git (fail-open si no hay python3)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guardia.py\" || exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
